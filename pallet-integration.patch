     restart: unless-stopped
+    build:
+      # Built locally from this checkout so the pallet extension (packages/pallet,
+      # referenced by api/composer.json as a path repo) is included in the image.
+      context: .
+      dockerfile: docker/Dockerfile
+      target: app-release
     image: fleetbase/fleetbase-api:latest
     volumes:
       - ./api/.env:/fleetbase/api/.env
diff --git a/docker/Dockerfile b/docker/Dockerfile
